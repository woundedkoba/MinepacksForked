<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>MinepacksForked</artifactId>
    <parent>
        <groupId>at.pcgamingfreaks</groupId>
        <artifactId>Minepacks-Parent</artifactId>
        <version>${revision}</version>
        <relativePath>..</relativePath>
    </parent>
    <packaging>jar</packaging>

    <name>MinepacksForked</name>
    <description>Self-contained Minepacks backpack plugin for Paper.</description>
    <url>https://github.com/woundedkoba/MinepacksForked</url>

    <properties>
        <!-- Runtime identity is stable across Maven artifact renames. -->
        <pluginName>Minepacks</pluginName>
        <mainClass>at.pcgamingfreaks.Minepacks.Bukkit.Minepacks</mainClass>
        <releaseType>Release</releaseType>
        <updateChannel>Release</updateChannel>
    </properties>

    <dependencies>
        <dependency>
            <groupId>at.pcgamingfreaks</groupId>
            <artifactId>Minepacks-API</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>at.pcgamingfreaks</groupId>
            <artifactId>Minepacks-MagicValues</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Frozen GPLv3 library snapshot kept in this repository. No second runtime plugin. -->
        <dependency>
            <groupId>at.pcgamingfreaks</groupId>
            <artifactId>Minepacks-EmbeddedLib</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.8.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testSourceDirectory>test/src</testSourceDirectory>
        <resources>
            <resource>
                <directory>resources</directory>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>./</directory>
                <includes><include>LICENSE</include></includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0-M4</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${mavenShade.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <minimizeJar>false</minimizeJar>
                            <artifactSet>
                                <includes>
                                    <include>at.pcgamingfreaks:Minepacks-API</include>
                                    <include>at.pcgamingfreaks:Minepacks-MagicValues</include>
                                    <include>at.pcgamingfreaks:Minepacks-EmbeddedLib</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>at.pcgamingfreaks:Minepacks-EmbeddedLib</artifact>
                                    <excludes>
                                        <exclude>at/pcgamingfreaks/PluginLib/**</exclude>
                                        <exclude>at/pcgamingfreaks/Bungee/**</exclude>
                                        <exclude>plugin.yml</exclude>
                                        <exclude>paper-plugin.yml</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
